{
  "name": "kanban",
  "version": "1.0.0",
  "private": true,
  "description": "HTML, CSS, JavaScript로 만든 칸반보드",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/database.test.js",
    "check:supabase": "node scripts/check-supabase.cjs",
    "vendor:supabase": "node scripts/vendor-supabase.cjs"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
